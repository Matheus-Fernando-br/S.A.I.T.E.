# S.A.I.T.E. backend — copie para .env e ajuste. Nenhum valor aqui é secreto.

# Onde ficam o banco SQLite e os arquivos originais importados
SAITE_DATA_DIR=./data

# Token opcional da API. Se definido, todas as rotas /api exigem
# "Authorization: Bearer <token>". Recomendado se a porta for exposta além de localhost.
SAITE_API_TOKEN=

# Origens autorizadas (CORS), separadas por vírgula
SAITE_CORS_ORIGINS=http://localhost:3000,https://saite-agent.vercel.app

# Provedor de modelo local: "ollama" ou "openai_compatible" (llama.cpp llama-server, LM Studio...)
SAITE_LLM_PROVIDER=ollama
SAITE_LLM_BASE_URL=http://127.0.0.1:11434
SAITE_CHAT_MODEL=qwen2.5:7b
# bge-m3 (multilíngue, ~1,2 GB) tem boa qualidade em português; nomic-embed-text (~275 MB) é mais leve
SAITE_EMBED_MODEL=bge-m3
# Só para servidores OpenAI-compatíveis locais que exijam chave (não é chave da OpenAI)
SAITE_LLM_API_KEY=

# Agente local do computador (processo separado: ver agent/README.md)
SAITE_AGENT_URL=http://127.0.0.1:8765
SAITE_AGENT_TOKEN=

# Limites
SAITE_MAX_UPLOAD_MB=25
SAITE_MAX_URL_MB=5
