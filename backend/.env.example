# S.A.I.T.E. backend — copie para .env (desenvolvimento) ou cadastre no Render
# (Dashboard → serviço → Environment). Nenhum valor real aqui.

# --- Obrigatórias em produção (segredos: cadastre direto no Render) ---
# Supabase → Connect → "Session pooler" (funciona por IPv4, que é o que o Render usa)
DATABASE_URL=postgresql://postgres.<ref-do-projeto>:<senha-do-banco>@aws-1-us-west-1.pooler.supabase.com:5432/postgres
# Senha para entrar no S.A.I.T.E. em qualquer dispositivo (vazia = API aberta, só para desenvolvimento)
SAITE_ACCESS_PASSWORD=
# Chave do provedor de IA (ex.: Google AI Studio → Get API key)
SAITE_LLM_API_KEY=

# --- Provedor de IA (padrão: Gemini pela API compatível com OpenAI) ---
SAITE_LLM_PROVIDER=openai_compatible
SAITE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SAITE_CHAT_MODEL=gemini-2.5-flash
SAITE_EMBED_MODEL=gemini-embedding-001
# Embeddings em outro provedor (opcional; vazio = mesmo do chat)
SAITE_EMBED_PROVIDER=
SAITE_EMBED_BASE_URL=
SAITE_EMBED_API_KEY=
# Alternativas: Groq (modelos abertos) https://api.groq.com/openai/v1 com SAITE_CHAT_MODEL=llama-3.3-70b-versatile
#               Ollama local: SAITE_LLM_PROVIDER=ollama e SAITE_LLM_BASE_URL=http://127.0.0.1:11434

# --- Opcionais ---
SAITE_CORS_ORIGINS=http://localhost:3000,https://saite-agent.vercel.app
SAITE_SESSION_DAYS=90
SAITE_MAX_UPLOAD_MB=15
SAITE_MAX_URL_MB=5
# Agente local do computador: só quando o backend roda na mesma máquina (versão desktop)
SAITE_AGENT_URL=
SAITE_AGENT_TOKEN=
